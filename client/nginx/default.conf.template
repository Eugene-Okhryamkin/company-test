# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# ${API_UPSTREAM} comes from the environment (see Dockerfile / docker-compose.yml).

# "Connection: upgrade" only when the client asks for a WebSocket upgrade.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compress text responses: static bundle and proxied API JSON.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json;

    # Live updates: long-lived WebSocket to the backend.
    location = /api/live {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Fail fast when the backend is down, so the client's backoff takes over.
        proxy_connect_timeout 5s;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # API → backend container (same origin for the browser, no CORS).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_connect_timeout 5s;
        # AI search waits for the LLM (backend timeout AI_SEARCH_TIMEOUT_MS, 15 s by default).
        proxy_read_timeout 30s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed Vite assets never change → cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback; index.html is always revalidated so new deploys are picked up.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
