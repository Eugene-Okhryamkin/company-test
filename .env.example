# Copy to .env to override. docker-compose reads .env automatically.
# Host port for the web client (nginx: static + /api proxy + /api/live WebSocket).
CLIENT_PORT=5173
# Host port for direct backend access (optional; the client reaches it via the internal network).
BACKEND_PORT=8080

# Live updates (mock real-time data source on the backend)
LIVE_UPDATES_ENABLED=true
# How often data changes, ms (min 250)
LIVE_UPDATE_INTERVAL_MS=3000
# Max nodes changed per tick
LIVE_UPDATE_MAX_NODES=3
# Server ping + heartbeat message interval, ms
LIVE_HEARTBEAT_INTERVAL_MS=15000
